<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Editar producto</h1>
    <a href='index.php?c=product&panelAdmin'>panel de admin</a>

    <form action="index.php?c=product&update" method="POST">
        <input type="hidden" name="id" value="<?php echo $product->getId(); ?>">
        <input type="text" name="name" value="<?php echo htmlspecialchars($product->getName(), ENT_QUOTES, 'UTF-8'); ?>" required>
        <input type="text" name="description" value="<?php echo htmlspecialchars($product->getDescription(), ENT_QUOTES, 'UTF-8'); ?>" required>
        <input type="number" name="price" step="0.01" value="<?php echo htmlspecialchars($product->getPrice(), ENT_QUOTES, 'UTF-8'); ?>" required>
        <input type="number" name="stock" value="<?php echo htmlspecialchars($product->getStock(), ENT_QUOTES, 'UTF-8'); ?>" min="0" required>
        <input type="submit" value="Guardar cambio">
    </form>

    <a href="index.php?c=product&productsAdmin">Volver a productos</a>
</body>
</html>